# Audio file MIME types for iOS compatibility
<IfModule mod_mime.c>
  AddType audio/mpeg .mp3
  AddType audio/mp4 .m4a
  AddType audio/ogg .ogg
  AddType audio/wav .wav
</IfModule>

# Enable partial content support (required for iOS audio seeking)
<IfModule mod_headers.c>
  <FilesMatch "\.(mp3|m4a|ogg|wav)$">
    Header set Accept-Ranges bytes
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]

  # Handle React routes that conflict with physical directories
  RewriteRule ^press/?$ /index.html [L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-l
  RewriteRule . /index.html [L]
</IfModule>
