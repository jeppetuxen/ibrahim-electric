# Audio file MIME types for iOS compatibility
<IfModule mod_mime.c>
  AddType audio/mpeg .mp3
  AddType audio/mp4 .m4a
  AddType audio/ogg .ogg
  AddType audio/wav .wav
</IfModule>

# Enable partial content support (required for iOS audio seeking)
<IfModule mod_headers.c>
  # Audio files - long cache (1 year)
  <FilesMatch "\.(mp3|m4a|ogg|wav)$">
    Header set Accept-Ranges bytes
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>

  # HTML - no cache
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # JS and CSS - short cache (Vite adds content hashes)
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>

  # Images - medium cache (30 days)
  <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]

  # Handle React routes that conflict with physical directories
  RewriteRule ^press/?$ /index.html [L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-l
  RewriteRule . /index.html [L]
</IfModule>
